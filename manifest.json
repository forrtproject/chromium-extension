{
  "manifest_version": 3,
  "name": "FORRT ORE — Open Research Extension",
  "short_name": "FORRT ORE",
  "version": "0.1.0.5",
  "description": "Shows replication evidence, retractions, PubPeer comments and open-access copies for the papers on any page you read.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "alarms"
  ],
  "action": {
    "default_popup": "dist/popup.html"
  },
  "host_permissions": [
    "https://rep-api.forrt.org/*",
    "https://api.openalex.org/*",
    "https://api.crossref.org/*",
    "https://api.unpaywall.org/*",
    "https://doi.org/*",
    "https://data.crosscite.org/*",
    "https://pmc.ncbi.nlm.nih.gov/*",
    "https://docs.google.com/*",
    "https://pubpeer.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://scholar.google.com/*",
        "*://scholar.google.co.uk/*",
        "*://scholar.google.co.in/*",
        "*://scholar.google.co.jp/*",
        "*://scholar.google.co.kr/*",
        "*://scholar.google.co.za/*",
        "*://scholar.google.co.id/*",
        "*://scholar.google.co.th/*",
        "*://scholar.google.co.il/*",
        "*://scholar.google.ca/*",
        "*://scholar.google.de/*",
        "*://scholar.google.fr/*",
        "*://scholar.google.es/*",
        "*://scholar.google.it/*",
        "*://scholar.google.com.br/*",
        "*://scholar.google.com.au/*",
        "*://maps.google.com/*",
        "*://*.google.com/maps*",
        "*://*.google.co.uk/maps*",
        "*://*.google.co.in/maps*",
        "*://*.google.co.jp/maps*",
        "*://*.google.co.kr/maps*",
        "*://*.google.co.za/maps*",
        "*://*.google.co.id/maps*",
        "*://*.google.co.th/maps*",
        "*://*.google.co.il/maps*",
        "*://*.google.ca/maps*",
        "*://*.google.de/maps*",
        "*://*.google.fr/maps*",
        "*://*.google.es/maps*",
        "*://*.google.it/maps*",
        "*://*.google.com.br/maps*",
        "*://*.google.com.au/maps*",
        "*://forrt.org/*",
        "*://lukaswallrich.github.io/*"
      ],
      "js": [
        "dist/content-general.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://pubpeer.com/*",
        "*://*.pubpeer.com/*"
      ],
      "js": [
        "dist/content-pubpeer.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://forrt.org/*"
      ],
      "js": [
        "dist/content-forrt.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://github.com/forrtproject/chromium-extension/issues/new*"
      ],
      "js": [
        "dist/content-github.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://scholar.google.com/*",
        "*://scholar.google.co.uk/*",
        "*://scholar.google.co.in/*",
        "*://scholar.google.co.jp/*",
        "*://scholar.google.co.kr/*",
        "*://scholar.google.co.za/*",
        "*://scholar.google.co.id/*",
        "*://scholar.google.co.th/*",
        "*://scholar.google.co.il/*",
        "*://scholar.google.ca/*",
        "*://scholar.google.de/*",
        "*://scholar.google.fr/*",
        "*://scholar.google.es/*",
        "*://scholar.google.it/*",
        "*://scholar.google.com.br/*",
        "*://scholar.google.com.au/*",
        "*://openalex.org/*",
        "*://*.openalex.org/*"
      ],
      "js": [
        "dist/content-search.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "dist/options.html",
    "open_in_tab": true
  }
}